# ==============================================================================
# TravelMate — Smart Tourist Day-Visit Planner
# Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions: Copy this file to .env and adjust variables for your local or production environment.

# ----------------- SERVER CONFIGURATION -----------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ----------------- MYSQL DATABASE CONFIGURATION -----------------
# Local MySQL instance
DATABASE_URL=jdbc:mysql://localhost:3306/travel_mate_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password_here

# ----------------- JPA / HIBERNATE SETTINGS -----------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# ----------------- CORS CONFIGURATION -----------------
# Comma-separated list of allowed origins (e.g. http://localhost:5500, http://127.0.0.1:5500)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ----------------- ACADEMIC DEMONSTRATION ADMIN ACCOUNT -----------------
DEFAULT_ADMIN_EMAIL=admin@travelmate.lk
DEFAULT_ADMIN_PASSWORD=admin123
